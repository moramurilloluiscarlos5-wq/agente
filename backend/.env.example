PORT=4000
# En desarrollo local: 127.0.0.1. En producción (Railway): 0.0.0.0 (valor por defecto).
HOST=127.0.0.1
# En producción define aquí el dominio público de Railway.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Supabase (nunca exponer la service role key en el frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA (solo backend; nunca usar prefijo VITE_ para estas variables)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Device Tools: clave maestra solo del backend para derivar claves por taller/agente.
# Nunca copies este secreto al navegador ni al PC del técnico.
DEVICE_AGENT_SECRET=
DEVICE_AGENT_ID=
DEVICE_AGENT_VERSION=1.0.0
# Public GitHub repository containing signed device-agent-v* releases (owner/repo).
DEVICE_AGENT_GITHUB_REPOSITORY=
# Optional server-only token for GitHub API rate limits; never use VITE_ here.
DEVICE_AGENT_GITHUB_TOKEN=
# Optional temporary test distribution. It is explicitly marked unsigned and
# never replaces a verified GitHub release when DEVICE_AGENT_GITHUB_REPOSITORY is set.
DEVICE_AGENT_EXTERNAL_RELEASE_URL=
DEVICE_AGENT_EXTERNAL_VERSION=

# WhatsApp Business Cloud API (solo backend)
WHATSAPP_ENABLED=false
WHATSAPP_SIMULATE=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_DEFAULT_COUNTRY=52

# Licencias por suscripción (Plus, Pro, Max) cobradas con Mercado Pago. Solo backend;
# en producción son obligatorias. Mercado Pago → Tus integraciones → tu aplicación:
#   MP_ACCESS_TOKEN: Credenciales de producción → Access Token (APP_USR-…). Para probar,
#     usa el Access Token del usuario vendedor de prueba.
#   MP_WEBHOOK_SECRET: Webhooks → Configurar notificaciones → clave secreta.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública de la app (https en producción), sin barra final. Mercado Pago regresa al
# cliente a APP_PUBLIC_URL/facturacion después de pagar.
APP_PUBLIC_URL=
# Días de prueba sin tarjeta al registrar un taller (por defecto 14)
TRIAL_DAYS=14
# Días de gracia tras un cobro rechazado antes de bloquear (por defecto 10, lo que dura
# el reintento de Mercado Pago)
BILLING_GRACE_DAYS=10
# Interruptor: LICENSING_ENABLED=false apaga el control de licencias (nadie se bloquea y
# Mercado Pago no es obligatorio). Cualquier otro valor, o sin definir, las mantiene activas.
LICENSING_ENABLED=true
# Cabeceras de seguridad: la CSP se envía en modo "solo reporte" (no bloquea nada; cada violación
# aparece en los logs como [csp-report]). Pon CSP_ENFORCE=true para aplicarla cuando los logs estén limpios.
CSP_ENFORCE=false

