PORT=4000
# En desarrollo local: 127.0.0.1. En producción (Railway): 0.0.0.0 (valor por defecto).
HOST=127.0.0.1
# En producción define aquí el dominio público de Railway.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Supabase (nunca exponer la service role key en el frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA (solo backend; nunca usar prefijo VITE_ para estas variables)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Device Tools: solo firma sesiones cortas para el agente local; nunca ejecuta adb.
# Usa un secreto aleatorio de al menos 32 caracteres y configúralo también en el
# PC del técnico junto con DEVICE_AGENT_WORKSHOP_ID.
DEVICE_AGENT_SECRET=
DEVICE_AGENT_ID=
DEVICE_AGENT_VERSION=1.0.0
# Public GitHub repository containing signed device-agent-v* releases (owner/repo).
DEVICE_AGENT_GITHUB_REPOSITORY=
# Optional server-only token for GitHub API rate limits; never use VITE_ here.
DEVICE_AGENT_GITHUB_TOKEN=
# Optional temporary test distribution. It is explicitly marked unsigned and
# never replaces a verified GitHub release when DEVICE_AGENT_GITHUB_REPOSITORY is set.
DEVICE_AGENT_EXTERNAL_RELEASE_URL=
DEVICE_AGENT_EXTERNAL_VERSION=

# WhatsApp Business Cloud API (solo backend)
WHATSAPP_ENABLED=false
WHATSAPP_SIMULATE=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_DEFAULT_COUNTRY=52
