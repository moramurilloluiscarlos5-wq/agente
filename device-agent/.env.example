# Nunca expongas este agente en 0.0.0.0. El valor por defecto es localhost.
DEVICE_AGENT_HOST=127.0.0.1
DEVICE_AGENT_PORT=5391
DEVICE_AGENT_SECRET=
DEVICE_AGENT_WORKSHOP_ID=
DEVICE_AGENT_ID=
DEVICE_AGENT_ALLOWED_ORIGINS=https://carlostech-ai-production.up.railway.app,http://localhost:5173,http://127.0.0.1:5173
DEVICE_AGENT_BACKEND_URL=https://carlostech-ai-production.up.railway.app
DEVICE_AGENT_STATE_FILE=
# Deja estas rutas vacías para utilizar platform-tools junto al ejecutable.
# Si no están incluidos, se buscarán adb y fastboot en PATH.
ADB_PATH=
FASTBOOT_PATH=
DEVICE_AGENT_FILES_DIR=
DEVICE_AGENT_POLL_MS=2000
