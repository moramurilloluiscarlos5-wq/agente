# ¡IMPORTANTE! Este proyecto NO usa PostgreSQL propio ni DATABASE_URL.
# La base de datos es SUPABASE (PostgreSQL administrado externo).
# NO crear un servicio PostgreSQL en Railway para este proyecto.

# ─ Frontend → frontend/.env (solo desarrollo local) ─────────────
# En desarrollo local apunta al backend local.
# En producción (Railway, un solo servicio) esta variable NO debe definirse:
# el frontend usa automáticamente el mismo dominio ("/api").
VITE_API_URL=http://localhost:4000/api

# Supabase (claves públicas: pueden ir en el frontend, nunca la service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Agente local en la PC del técnico (por defecto http://127.0.0.1:5391).
VITE_DEVICE_AGENT_URL=http://127.0.0.1:5391
# Backend/Railway: public GitHub repository with signed Device Agent releases.
DEVICE_AGENT_GITHUB_REPOSITORY=
DEVICE_AGENT_GITHUB_TOKEN=

# ─ Backend → backend/.env (desarrollo) / Variables de Railway (producción) ──
# Railway inyecta PORT automáticamente; no definir un puerto fijo en producción.
PORT=4000
# HOST en local puede ser 127.0.0.1; en Railway deja 0.0.0.0 (valor por defecto).
HOST=127.0.0.1
# En producción define aquí el dominio público, por ejemplo:
# CORS_ORIGIN=https://carlostech-ai-production.up.railway.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# IA solo en backend; nunca usar VITE_ para estas variables.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Supabase (backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp opcional; credenciales adicionales en backend/.env.example.
WHATSAPP_ENABLED=false
WHATSAPP_SIMULATE=false
